<?php

namespace App\Filament\Resources;

use App\Filament\Resources\{{ class }}Resource\Pages;
use App\Models\{{ class }};
use Filament\Forms;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;
{{ extra_use }}

class {{ class }}Resource extends Resource
{
    protected static ?string $model = {{ class }}::class;

    protected static ?string $navigationLabel = '{{ label }}';

    protected static ?string $navigationIcon = '{{ icon }}';

    protected static ?string $navigationGroup = '{{ group }}';
{{ supports }}

    public static function form(Form $form): Form
    {
        return $form->schema([
{{ form_fields }}
        ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
{{ table_columns }}
            ])
            ->filters([
{{ table_filters }}
            ])
            ->actions([
                Tables\Actions\EditAction::make(),
                Tables\Actions\DeleteAction::make(),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                ]),
            ]);
    }

    public static function getRelations(): array
    {
        return [
{{ relation_managers }}
        ];
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\List{{ table_pascal }}::route('/'),
            'create' => Pages\Create{{ table_pascal }}::route('/create'),
            'edit' => Pages\Edit{{ table_pascal }}::route('/{record}/edit'),
        ];
    }
}
